{
  "name": "etappe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "pb": "bash scripts/pb.sh",
    "pb:setup": "bash scripts/get-pocketbase.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "types:pb": "pocketbase-typegen --db pb_data/data.db --out src/types/pb.ts",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint . && vitest run --passWithNoTests",
    "sprites": "tsx scripts/build-sprites.ts"
  },
  "dependencies": {
    "pocketbase": "^0.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@mapbox/maki": "^8.2.0",
    "@rapideditor/temaki": "^5.13.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "pocketbase-typegen": "^1.5.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
