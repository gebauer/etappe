# Etappe environment — copy to .env and fill in.
# Names match BUILD.md §11. .env is gitignored; never commit real secrets.

# --- Server-side only (read in pb_hooks via $os.getenv, never sent to the browser) ---

# OpenRouteService API key. Used by pb_hooks/route.js. The key stays on the
# server; the browser never calls ORS directly.
ORS_API_KEY=

# --- Client-facing services (safe to expose; the browser talks to these directly) ---

# MapLibre vector tile / style URL. Default is OpenFreeMap; swap for MapTiler.
TILE_URL=https://tiles.openfreemap.org/styles/liberty

# Photon geocoding base URL.
PHOTON_URL=https://photon.komoot.io

# Overpass API endpoint for the Nearby POI query.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Public base URL of the deployed app. Used for share links and CORS origins.
APP_URL=http://localhost:8090
