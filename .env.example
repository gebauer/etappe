# Etappe environment — copy to .env and fill in.
# .env is gitignored and loaded by `npm run pb`; never commit real secrets.

# --- Routing (server-side; the key never reaches the browser) --------------

# Which routing backend the /api/route hook uses: "ors" (default) or "osrm".
ROUTING_BACKEND=ors

# ORS (default backend). api.openrouteservice.org is DEPRECATED (shut off
# 2026-08-24) — use the HeiGIT base below. Your existing key works unchanged.
ORS_URL=https://api.heigit.org/openrouteservice/v2
ORS_API_KEY=

# OSRM (only when ROUTING_BACKEND=osrm) — base URL of a self-hosted OSRM, e.g.
# https://osrm.example.com . No key; keeps routing fully self-hosted.
OSRM_URL=

# --- Client-facing services (safe to expose; the browser calls these) ------

# MapLibre vector tile / style URL. Default OpenFreeMap; swap for MapTiler.
# The SPA reads this at build time as VITE_TILE_URL (see MapPane).
TILE_URL=https://tiles.openfreemap.org/styles/liberty

# Photon geocoding base URL.
PHOTON_URL=https://photon.komoot.io

# Overpass API endpoint for the Nearby POI query.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Public base URL of the deployed app. Used for share links and CORS origins.
APP_URL=http://localhost:8090
