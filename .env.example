# Etappe environment — copy to .env and fill in.
# .env is gitignored and loaded by `npm run pb`; never commit real secrets.

# --- Routing (server-side; the key never reaches the browser) --------------

# Which routing backend the /api/route hook uses: "ors" (default), "here"
# or "osrm". This is the FALLBACK: a trip uses its *owner's* engine and key
# when they have set one in Account settings (WORK 19.1).
ROUTING_BACKEND=ors

# ORS. api.openrouteservice.org is DEPRECATED (shut off 2026-08-24) — use the
# HeiGIT base below. Your existing key works unchanged. Note ORS's car profile
# is very conservative on gravel and highland roads.
ORS_URL=https://api.heigit.org/openrouteservice/v2
ORS_API_KEY=

# HERE Routing v8 (ROUTING_BACKEND=here). Free tier, no card. Chosen over
# Google/Mapbox because its terms permit caching results, which route_cache
# depends on. Get a key at https://platform.here.com .
HERE_API_KEY=

# OSRM (only when ROUTING_BACKEND=osrm) — base URL of a self-hosted OSRM, e.g.
# https://osrm.example.com . No key; keeps routing fully self-hosted.
OSRM_URL=

# --- Client-facing services (safe to expose; the browser calls these) ------
#
# These three are BUILD-TIME only — baked into the SPA bundle by
# `docker-compose build` (see the Dockerfile), not read by the running
# container. Putting them in .env works for local `docker-compose build`
# (compose substitutes them into the build args); in Coolify set them as
# build-time variables, not just runtime ones. Leave any of them blank to
# keep the app's public default (OpenFreeMap / Photon / Overpass) — an empty
# value here is NOT the same as `VITE_TILE_URL=""` reaching the bundle; the
# Dockerfile only exports the VITE_ var when the build arg is non-empty.

# MapLibre vector tile / style URL. Default OpenFreeMap; swap for MapTiler.
TILE_URL=https://tiles.openfreemap.org/styles/liberty

# Photon geocoding base URL.
PHOTON_URL=https://photon.komoot.io

# Overpass API endpoint for the Nearby POI query.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Deployment (Coolify / docker-compose only; unused by `npm run pb`) ----

# Public base URL of the deployed app. Not read anywhere yet — reserved for
# the share endpoint (BUILD §11/WORK phase 9), which isn't built.
APP_URL=http://localhost:8090

# First superuser, created (or updated) on every container start if both are
# set — see scripts/docker-entrypoint.sh. Leave blank to create it by hand
# instead: `pocketbase superuser upsert <email> <password> --dir=/pb/pb_data`
# via Coolify's container terminal.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
